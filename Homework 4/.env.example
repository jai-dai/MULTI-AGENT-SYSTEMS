# Copy this file to .env and fill in your values
# cp .env.example .env

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Any chat model with tool-calling support
MODEL_NAME=gpt-4.1-mini

# Optional overrides (defaults live in config.py)
# MAX_SEARCH_RESULTS=5
# MAX_URL_CONTENT_LENGTH=8000
# MAX_ITERATIONS=10
# OUTPUT_DIR=output

# Timeouts are deliberately separate: a page must not stall the agent,
# while a reasoning model legitimately needs minutes per call.
# REQUEST_TIMEOUT=60
# MODEL_TIMEOUT=300
