# Скопіювати у .env і вписати свій ключ. .env у .gitignore.

OPENAI_API_KEY=sk-...
# MODEL_NAME=claude-opus-5     — і працює друга гілка llm.py
# ANTHROPIC_API_KEY=sk-ant-...   (в один момент часу лише один MODEL_NAME)
MODEL_NAME=gpt-5.2

# Ембеддинги локально, через Ollama: `ollama pull bge-m3`.
# Прибрати ці три рядки — і ембеддинги підуть в OpenAI разом з усім корпусом.
EMBEDDING_BACKEND=compat
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_IDENTITY=bge-m3

# faiss — один файл і точний перебір; qdrant — фільтри за метаданими,
# розріджені вектори й дозапис без перезбирання. Обидва локальні.
VECTOR_BACKEND=qdrant

# Куди пише ingest.py і по чому шукає агент. Розділені навмисно: запис іде
# рівно в один індекс, а пошук може йти по кількох через кому.
INDEX_DIR=index
SEARCH_INDEX_DIRS=index
