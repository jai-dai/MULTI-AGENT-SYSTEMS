OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_BACKEND=compat
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_IDENTITY=bge-m3
EXCLUDE_FILES=~$*,.env,*.key,*.pem,id_rsa*,*recovery*code*
MODEL_NAME=gpt-5.2
VECTOR_BACKEND=qdrant

# Демо у hw8 идёт по ПУБЛИЧНОЙ теме, поэтому и база знаний публичная:
# три PDF из data/ (RAG, LangChain, LLM). Приватные index_vl и index_mail
# слинкованы рядом, но в поиск НЕ включены намеренно — иначе отчёт,
# который мы потом покажем в README, наберёт настоящих контрагентов.

# Локальный сервер Qdrant — тот же, что у агента, коллекция «index».
# Изоляция индексов на сервере держится на ИМЕНИ коллекции, а не на каталоге.
QDRANT_URL=http://localhost:6333
QDRANT_START_CMD=/Users/dhanika/Documents/VL/qdrant/start.sh

# Публичная база знаний — три PDF из data/, коллекция «index» на сервере Qdrant.
INDEX_DIR=index
SEARCH_INDEX_DIRS=index

# Порты серверов протоколов.
SEARCH_MCP_PORT=8901
REPORT_MCP_PORT=8902
ACP_PORT=8903

# ---- A2A: один сервер = один агент ----
PLANNER_PORT=8903
RESEARCHER_PORT=8904
CRITIC_PORT=8905
