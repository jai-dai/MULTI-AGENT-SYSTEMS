# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- chat model (generation) ----
# The provider is derived from MODEL_NAME (see llm.py): a name starting with
# "claude" goes to Anthropic's /v1/messages, anything else to an OpenAI-style
# /v1/chat/completions. LLM_BACKEND=openai|anthropic overrides the guess.
OPENAI_API_KEY=sk-your-api-key-here
MODEL_NAME=gpt-5.2

# Anthropic — a different protocol, spoken through the official SDK:
#   .venv/bin/pip install anthropic
# MODEL_NAME=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_FALLBACKS=true    # on a safety refusal, retry on a fallback model
# MAX_OUTPUT_TOKENS=16000     # required by Anthropic, optional for OpenAI

# Any OpenAI-compatible endpoint — no code change, no extra package.
# DeepSeek, for example:
# CHAT_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash
# API_KEY=sk-...              # vendor-neutral alias for OPENAI_API_KEY

# ---- embeddings (retrieval) ----
# Independent of the chat model: passages reach the model as TEXT, never as
# vectors. Changing anything here requires `python ingest.py --rebuild`.
#
# EMBEDDING_BACKEND=openai            # openai | local | compat
# EMBEDDING_MODEL=text-embedding-3-small
#
# local — nothing leaves the machine:
# EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=BAAI/bge-m3         # 1024-dim, multilingual
#
# e5 models are trained WITH prefixes; omitting them silently costs accuracy:
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "
#
# compat — any OpenAI-compatible /v1/embeddings (Ollama shown):
# EMBEDDING_BACKEND=compat
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=ollama            # dummy; Ollama ignores it

# ---- corpus & retrieval ----
# DATA_DIR=data                       # comma-separated: data,/Users/me/docs
# Directory names the walk never enters; hidden dirs are always skipped.
# EXCLUDE_DIRS=.git,.venv,node_modules,__pycache__,site-packages,dist,build
# Filenames never ingested (fnmatch, case-insensitive). `~$*` are Office lock
# files — not documents. The rest is a privacy floor: an indexed chunk is one
# retrieval away from being pasted into a prompt. Extend it per corpus, e.g.
# payroll*, *contract*draft*.  Applies to NEW runs; use `--clean` for an index
# that already exists.
# EXCLUDE_FILES=~$*,.env,*.key,*.pem,id_rsa*,*recovery*code*
# INDEX_DIR=index
# Where vectors live: faiss | qdrant. Qdrant runs embedded (no server, no
# Docker) and can filter by metadata BEFORE scoring; FAISS can only filter
# after. Switching engines needs no re-embedding:
#   python ingest.py --migrate-store faiss:qdrant
# VECTOR_BACKEND=faiss
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# RETRIEVAL_TOP_K=10                  # candidates from EACH retriever
# RERANK_TOP_N=3                      # passages that survive reranking
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_MIN_SCORE=0.02
# MAX_ITERATIONS=10

# ---- OCR (scanned PDFs) ----
# OCR_BACKEND=auto            # off | auto | vision | tesseract
# OCR_LANGUAGES=uk,ru,en
# OCR_DPI=200
# OCR_MIN_CHARS=50            # below this a page is treated as un-extracted
# OCR_MAX_PAGES=40            # OCR costs seconds per page
# TESSERACT_CMD=tesseract

# EMBEDDING_IDENTITY=bge-m3   # asserts two runtimes give compatible vectors
