# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- chat model (generation) ----
OPENAI_API_KEY=sk-your-api-key-here
MODEL_NAME=gpt-5.2
# Any OpenAI-compatible endpoint. DeepSeek, for example:
# CHAT_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash

# ---- embeddings (retrieval) ----
# Independent of the chat model: passages reach the model as TEXT, never as
# vectors. Changing anything here requires `python ingest.py --rebuild`.
#
# EMBEDDING_BACKEND=openai            # openai | local | compat
# EMBEDDING_MODEL=text-embedding-3-small
#
# local — nothing leaves the machine:
# EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=BAAI/bge-m3         # 1024-dim, multilingual
#
# e5 models are trained WITH prefixes; omitting them silently costs accuracy:
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "
#
# compat — any OpenAI-compatible /v1/embeddings (Ollama shown):
# EMBEDDING_BACKEND=compat
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=ollama            # dummy; Ollama ignores it

# ---- corpus & retrieval ----
# DATA_DIR=data                       # comma-separated: data,/Users/me/docs
# INDEX_DIR=index
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# RETRIEVAL_TOP_K=10                  # candidates from EACH retriever
# RERANK_TOP_N=3                      # passages that survive reranking
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_MIN_SCORE=0.02
# MAX_ITERATIONS=10
