.env
# Run logs: `python -u ingest.py 2>&1 | tee ingest.log` (see README → Ingestion).
# Useful locally, meaningless in the repository — they describe one machine's run.
*.log
# Твоя настоящая почта: SQLite с письмами и сохранённые вложения.
# Приватные данные конкретной машины — в репозиторий не идут никогда.
mail/
__pycache__/
*.pyc
output/
index*/
.idea/
.venv/
.DS_Store

# Личные данные: домены контрагентов и разметка по своему корпусу.
# В репозиторий уезжают только *.example — см. weights.example.yaml.
weights.yaml
eval_queries.json
