# Скопіювати у .env і вписати свій ключ. .env у .gitignore.

OPENAI_API_KEY=sk-...
# MODEL_NAME=claude-opus-5     — і працює друга гілка llm.py
# ANTHROPIC_API_KEY=sk-ant-...   (в один момент часу лише один MODEL_NAME)
MODEL_NAME=gpt-5.2

# Ембеддинги локально, через Ollama: `ollama pull bge-m3`.
# Прибрати ці три рядки — і ембеддинги підуть в OpenAI разом з усім корпусом.
EMBEDDING_BACKEND=compat
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_IDENTITY=bge-m3

VECTOR_BACKEND=qdrant

# Qdrant СЕРВЕРОМ, а не вбудованим режимом — і це передумова всієї роботи.
# Вбудований тримає блокування на каталозі індексу, тож другий процес до нього
# просто не підійде. Чотири процеси hw9 існують лише тому, що сховище спільне.
QDRANT_URL=http://localhost:6333
QDRANT_START_CMD=/шлях/до/qdrant/start.sh

# Куди пише ingest.py і по чому шукає агент. Розділені навмисно: запис іде
# рівно в один індекс, а пошук може йти по кількох через кому.
INDEX_DIR=index
SEARCH_INDEX_DIRS=index

# Порти серверів протоколів. Виклик функції став мережевим запитом, і порт —
# це тепер адреса інструмента й агента.

# ---- оценка (hw10) ----
# Модель СУДЬИ для LLM-as-a-Judge. Отдельно от MODEL_NAME намеренно: судья
# обязан быть ДРУГИМ вендором, чем система, иначе модель ставит оценку
# собственной работе и завышает её (лекция 11, антипаттерн 3). Пустое значение
# означает «та же модель, что у системы» — тесты в этом случае предупреждают.
JUDGE_MODEL_NAME=claude-opus-5

# ---- порты СВОИХ серверов (hw10) ----
# Разведены с hw9 намеренно, и это не косметика. Пока порты совпадали, e2e-прогон
# уходил на ACP-сервер, поднятый из кода hw9, — то есть тесты hw10 измеряли
# СОСЕДНЮЮ систему. Поймано на том, что исправление, работавшее на компонентном
# уровне, никак не проявлялось в сквозном.
#
# Теперь hw9 и hw10 поднимаются одновременно и не мешают друг другу, а перепутать
# их нельзя в принципе.
SEARCH_MCP_PORT=8911
REPORT_MCP_PORT=8912
ACP_PORT=8913
