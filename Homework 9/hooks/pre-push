#!/bin/sh
# Не пустить личные имена в публичный репозиторий.
#
# Ставится в публикующий репозиторий:
#   cp hooks/pre-push <публичный репозиторий>/.git/hooks/ && chmod +x ...
# и там правятся три пути ниже.
#
# Список имён лежит в исходном репозитории и в публичный не копируется:
# опубликовать его значило бы собрать утечку в один аккуратный файл. Сам
# скрипт публикуется — в нём нет ни одного имени.
#
# Проверяются ТОЛЬКО отслеживаемые файлы — ровно то, что уйдёт в push. Раньше
# проверялся весь каталог, и хук останавливал push из-за `output/` (ответы
# агента с настоящими ФИО и паспортными данными). Файлы эти в .gitignore и
# уйти не могли, но проверка об этом не знала: страж, который ругается на то,
# чего он не публикует, приучает жать --no-verify.
#
# Обойти осознанно: git push --no-verify
NAMES="/Users/dhanika/MULTI-AGENT-SYSTEMS/homework-lesson-5/.private-names.txt"
CHECKER="/Users/dhanika/MULTI-AGENT-SYSTEMS/homework-lesson-5/check_names.py"
PYTHON="/Users/dhanika/MULTI-AGENT-SYSTEMS/homework-lesson-5/.venv/bin/python"
REPO="$(git rev-parse --show-toplevel)"

# Отсутствие списка — это НЕ повод пропустить проверку: именно в таком виде
# страж молча перестал бы работать.
if [ ! -f "$NAMES" ] || [ ! -f "$CHECKER" ]; then
    echo "⛔ pre-push: не найден список имён или проверяющий скрипт." >&2
    echo "   Проверка приватности НЕ выполнена — push остановлен." >&2
    exit 1
fi

cd "$REPO" || exit 1
git ls-files -z | xargs -0 "$PYTHON" "$CHECKER" --names "$NAMES" || exit 1
