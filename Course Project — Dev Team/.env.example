OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Эмбеддинги — локальная Ollama, тот же bge-m3, что и в прошлых работах.
EMBEDDING_BACKEND=compat
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_IDENTITY=bge-m3
EXCLUDE_FILES=~$*,.env,*.key,*.pem,id_rsa*,*recovery*code*

# Модель команды. Судья в тестах берётся отдельным ключом (см. tests/judge.py):
# оценивать свою же работу той же моделью — не оценка.
MODEL_NAME=gpt-5.2

VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_START_CMD=/Users/dhanika/Documents/VL/qdrant/start.sh

# База знаний команды: 20 документов о Python, тестировании и стиле кода.
# Собирается ./build_corpus.py, индексируется ingest.py в свою коллекцию —
# отдельную от индексов прошлых работ, чтобы поиск не тянул чужое.
DATA_DIR=corpus
INDEX_DIR=index_devteam
SEARCH_INDEX_DIRS=index_devteam

# Порты MCP-серверов.
DOCS_MCP_PORT=8931
WORKSPACE_MCP_PORT=8932
ACP_PORT=8903

# Langfuse. Пустые ключи = трассировка молча выключена, система работает.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_USER_ID=
